<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Ground colours match Palette.DAY / Palette.NIGHT so the window never flashes another colour. -->
  <color name="ground">#C8D1D5</color>
  <color name="sign_green">#006747</color>

  <style name="Theme.AutoPlus" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/ground</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
